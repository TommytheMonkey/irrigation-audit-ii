# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secret creds (Google service accounts, etc.)
/creds/

# dev-only photo uploads — prod uses Vercel Blob
/public/uploads/

# Tyler's archival reference material — ground truth is in REFERENCE_NOTES.md
/reference/

# Generated report PDFs (downloaded for local inspection)
/sys_reports/

# Local screenshot staging for bug reports
/screenshots/

# User guide drafts, demo screenplays, promo PDFs — distribute via Drive
/user-guide/
/openclaw/

# Raw source material for the sample-seed fixture. Compressed + renamed
# copies live in /public/sample and are what actually ships.
/default_project/

# service worker artifacts — generated by @serwist/next at build time
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/workbox-*.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# logos
/branding/